# Server-only. Leave blank for mock-mode UI demos.
ANTHROPIC_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Recommended for any public deployment with ANTHROPIC_API_KEY set.
# Visitors enter this code in the in-app "Demo access" field.
THREE_BODY_DEMO_ACCESS_CODE=

# Defaults are intentionally conservative.
THREE_BODY_RATE_LIMIT=12
THREE_BODY_RATE_WINDOW_MS=60000
THREE_BODY_MAX_REQUEST_BYTES=32000

# Set to true only if you intentionally want an unrestricted public demo.
THREE_BODY_PUBLIC_DEMO=false
